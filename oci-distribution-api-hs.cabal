cabal-version: 3.4
name: oci-distribution-api-hs
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
author: Mike Ledger
maintainer: haskell@bellroy.com
category: Distribution
build-type: Simple
extra-doc-files: CHANGELOG.md
data-files: test/*.json
tested-with:
  ghc ==8.10.7 || ==9.0.2 || ==9.2.4 || ==9.4.5 || ==9.6.6 || ==9.8.2 || ==9.10.1 || ==9.12.1

common common
  ghc-options: -Wall
  default-language: GHC2024

library
  import: common
  -- cabal-gild: discover src/
  exposed-modules:
    OpenContainerImage.Manifest
    OpenContainerImage.Manifest.Annotation
    OpenContainerImage.Registry

  build-depends:
    aeson,
    attoparsec,
    base ^>=4.21,
    bytestring,
    containers,
    http-client,
    http-client-tls,
    http-types,
    modern-uri,
    text,
    unliftio,
    vector,

  hs-source-dirs: src

test-suite oci-distribution-api-hs-test
  import: common
  type: exitcode-stdio-1.0
  build-depends:
    aeson,
    aeson-pretty,
    base ^>=4.21,
    bytestring,
    oci-distribution-api-hs,
    tasty,
    tasty-golden,

  -- cabal-gild: discover test/
  hs-source-dirs: test
  main-is: spec.hs

executable oci-read-one-layer
  import: common
  build-depends:
    base ^>=4.21,
    http-client,
    http-client-tls,
    network-uri,
    oci-distribution-api-hs,
    optics,
    optparse-applicative,
    optparse-generic,
    relude,
    vector,

  main-is: example/oci-read-one-layer.hs
